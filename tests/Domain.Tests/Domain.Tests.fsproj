<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <NoWarn>20</NoWarn>
    <IsPackable>false</IsPackable>
    <GenerateProgramFile>false</GenerateProgramFile>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Conversion.fs"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Moq" Version="4.21.0"/>
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.1"/>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2"/>
    <PackageReference Include="Microsoft.Testing.Extensions.TrxReport" Version="2.4.1"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Domain\Domain.fsproj"/>
  </ItemGroup>

</Project>